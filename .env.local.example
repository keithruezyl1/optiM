# Copy to .env.local and fill in. All server-only — never prefix with NEXT_PUBLIC.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
OPENAI_API_KEY=

# Optional x-api-key gate for the API routes. Leave unset for the demo;
# set it (and send a matching x-api-key header) to lock the endpoints down.
OPTIM_API_KEY=
